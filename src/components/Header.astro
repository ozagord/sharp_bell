---
---
<header class="site-header">
  <div class="container header-container">
    <a href="/" class="logo" aria-label="Sharp Bell Home">
      <img src="/favicon_option3.svg" alt="Sharp Bell Logo" style="height: 2.75rem; width: auto; display: block;" />
    </a>
    
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
    
    <nav class="main-nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/tags">Tags</a></li>
        <li>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
            <!-- Sun icon (shows in dark mode) -->
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <!-- Moon icon (shows in light mode) -->
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span class="theme-text">Dark Mode</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--bg-alt);
    padding: 0.25rem 0;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: var(--transition);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    z-index: 102; /* Above the nav when expanded */
    position: relative;
  }

  .logo:hover {
    color: var(--accent-color);
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 102; /* Above the nav */
    position: relative;
  }

  .hamburger:focus {
    outline: none;
  }

  .hamburger .bar {
    width: 2rem;
    height: 0.25rem;
    background: var(--heading-color);
    border-radius: 10px;
    transition: all 0.3s linear;
    position: relative;
    transform-origin: 1px;
  }

  .hamburger[aria-expanded="true"] .bar:first-child {
    transform: rotate(45deg);
  }

  .hamburger[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
    transform: translateX(20px);
  }

  .hamburger[aria-expanded="true"] .bar:nth-child(3) {
    transform: rotate(-45deg);
  }

  /* Navigation styling */
  .main-nav {
    position: fixed;
    top: 0;
    right: 0;
    background-color: var(--bg-color);
    width: 250px;
    height: 100vh;
    padding-top: 6rem;
    box-shadow: var(--shadow-md);
    transform: translateX(100%);
    transition: transform 0.3s ease-in-out;
    z-index: 101;
    border-left: 1px solid var(--border-color);
  }

  .main-nav.open {
    transform: translateX(0);
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0 2rem;
    gap: 1.5rem;
  }

  .main-nav a,
  .theme-toggle {
    font-family: var(--font-ui);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 1px;
    color: var(--text-main);
    padding: 0.5rem 0;
    display: block;
    text-decoration: none;
  }

  .main-nav a:hover,
  .theme-toggle:hover {
    color: var(--accent-color);
  }

  /* Theme toggle switch */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
  }

  /* Display icons based on theme */
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
  :global([data-theme="light"]) .sun-icon,
  :global(:not([data-theme="dark"])) .sun-icon {
    display: none;
  }
</style>

<script>
  // Use 'astro:page-load' event to make sure it works after Astro view transitions (if used)
  document.addEventListener('DOMContentLoaded', () => {
    setupMenu();
    setupTheme();
  });
  
  // also run on normal load just in case
  setupMenu();
  setupTheme();

  function setupMenu() {
    const hamburger = document.querySelector('.hamburger');
    const nav = document.querySelector('.main-nav');

    if (hamburger && nav && !hamburger.hasAttribute('data-initialized')) {
      hamburger.addEventListener('click', () => {
        const isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!isExpanded));
        nav.classList.toggle('open');
      });
      hamburger.setAttribute('data-initialized', 'true');
    }
  }

  function setupTheme() {
    const themeToggle = document.getElementById('theme-toggle');

    if (themeToggle && !themeToggle.hasAttribute('data-initialized')) {
      themeToggle.addEventListener('click', () => {
        const element = document.documentElement;
        const isDark = element.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        
        element.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });
      themeToggle.setAttribute('data-initialized', 'true');
    }
  }
</script>
