---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-container">
    <p>&copy; {year} Osvaldo Zagordi. All rights reserved.</p>
    <div class="social-links">
      <a href="https://github.com/ozagordi" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-alt);
    padding: 3rem 0;
    margin-top: 5rem;
    border-top: 1px solid var(--border-color);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  p {
    margin: 0;
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    color: var(--text-main);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .social-links a:hover {
    color: var(--accent-color);
  }
</style>
