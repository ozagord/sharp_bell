---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Get all unique tags and count occurrences
const tagCounts = allPosts.reduce((acc, post) => {
  const tags = post.data.tags || [];
  tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

// Sort tags alphabetically
const sortedTags = Object.keys(tagCounts).sort();
---

<BaseLayout title="All Tags">
  <div class="intro-header">
    <div class="container site-heading">
      <h1>Tags</h1>
      <span class="subheading">Explore topics</span>
    </div>
  </div>

  <div class="container tag-container">
    <div class="tags-list">
      {sortedTags.map(tag => (
        <a href={`/tags/${tag}`} class="tag-item">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{tagCounts[tag]}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .intro-header {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/header_gsl2.jpg') no-repeat center center;
    background-size: cover;
    margin-bottom: 50px;
    color: white;
    padding: 100px 0;
    text-align: center;
  }

  .site-heading h1 {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 10px;
    margin-top: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .site-heading .subheading {
    font-size: 1.5rem;
    font-weight: 300;
    font-family: var(--font-body);
  }

  .tag-container {
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    background-color: var(--bg-alt);
    border: 1px solid var(--border-color);
    border-radius: 30px;
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--text-main);
    transition: var(--transition);
  }

  .tag-item:hover {
    background-color: var(--heading-color);
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .tag-item:hover .tag-count {
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .tag-name {
    font-family: var(--font-ui);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.9rem;
    margin-right: 0.5rem;
  }

  .tag-count {
    background-color: var(--border-color);
    color: var(--text-main);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
    transition: var(--transition);
  }
</style>
