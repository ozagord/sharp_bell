---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About";
const description = "This is how I came here.";
const image = "/img/header_na.jpg";
---

<BaseLayout title={title} description={description} image={image}>
  <div
    class="hero-image"
    style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('${image}')`}
  >
    <div class="container hero-content animate-fade-in">
      <h1 class="page-title">{title}</h1>
      <p class="subheading">{description}</p>
    </div>
  </div>

  <div class="container page-container">
    <div class="post-content">
      <p>
        I studied physics, both master and PhD. Then I took a postdoc position
        at ETH Zurich to work on the analysis of large datasets of DNA
        sequences. Afterwards, I moved to the University of Zurich: still
        analysing DNA sequences, but for diagnostic purposes.
      </p>

      <p>
        In 2014, with a few colleagues, I founded <a href="http://www.engene.ch"
          >enGene Statistics</a
        >, a company offering consulting in data analytics, with a focus on
        bioinformatics/genomics.
      </p>

      <p>
        In 2018 I moved back to Italy where, after a brief stint in another
        startup, I was hired by a Telco company where I am still working as
        senior data scientist.
      </p>

      <p>
        Here I blog about <s>science</s>, <s>data</s>, <s>data science</s> stuff
        in general.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-image {
    height: 50vh;
    min-height: 300px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-content {
    color: white;
  }

  .page-title {
    color: white;
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .subheading {
    font-size: 1.5rem;
    font-weight: 300;
  }

  .page-container {
    max-width: 800px;
  }
</style>
