---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title="Home">
  <div class="intro-header">
    <div class="container site-heading">
      <h1>Sharp Bell</h1>
      <span class="subheading">Skiving on data</span>
    </div>
  </div>

  <div class="container">
    <div class="posts-list">
      {sortedPosts.map(post => (
        <article class="post-preview">
          <a href={`/post/${post.id}`}>
            <h2 class="post-title">{post.data.title}</h2>
          </a>
          <p class="post-meta">
            Posted by {post.data.author || 'Osvaldo'} on {new Date(post.data.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </p>
          <hr class="small" />
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .intro-header {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/header_gsl2.jpg') no-repeat center center;
    background-size: cover;
    margin-bottom: 50px;
    color: white;
    padding: 100px 0;
    text-align: center;
  }

  .site-heading h1 {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 10px;
    margin-top: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .site-heading .subheading {
    font-size: 1.5rem;
    font-weight: 300;
    font-family: var(--font-body);
  }

  .posts-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-preview {
    margin-bottom: 3rem;
    text-align: center;
  }

  .post-preview > a {
    color: var(--heading-color);
  }

  .post-preview > a:hover {
    color: var(--accent-color);
  }

  .post-title {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }

  .post-meta {
    font-style: italic;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  hr.small {
    max-width: 100px;
    margin: 15px auto;
    border-width: 4px;
    border-color: var(--heading-color);
    color: var(--heading-color);
    border-radius: 2px;
  }
</style>
